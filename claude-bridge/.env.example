# AI Data Engineering Studio - Portable Configuration
# Copy this file to .env and adjust if needed

# 1. Standard 3-Repository Layout:
# AI Data Engineering Studio/
# ├── claude-bridge/     # This Web Studio app (frontend + backend)
# ├── mcp-claude/        # Medallion skills (.claude/skills/medallion)
# └── fabric-mcp-server/ # Microsoft Fabric MCP server
#
# Defaults automatically resolve to sibling directories:
MCP_CLAUDE_DIR=../mcp-claude
FABRIC_MCP_DIR=../fabric-mcp-server

# 2. Server binding configuration
HOST=0.0.0.0
PORT=8000

# 3. Tool permission mode (auto-approves tool executions, keeps medallion gates gated)
PERMISSION_MODE=bypassPermissions

# 4. Optional custom binary paths (if not in standard system PATH)
# CLAUDE_BIN=/usr/local/bin/claude
# AZ_BIN=/usr/bin/az

# 5. Optional Microsoft Fabric Default Workspace (dynamic selection supported)
# FABRIC_WORKSPACE_ID=
# RAW_LAKEHOUSE_NAME=
