# Microsoft Fabric & Azure Authentication Environment Variables
# Copy this file to .env and fill in your values for portable execution across any machine

# Microsoft Fabric Workspace Configuration (Optional if auto-resolving active workspace)
FABRIC_WORKSPACE_ID=
FABRIC_WORKSPACE_NAME=

# Default Raw Lakehouse Configuration (Optional fallback; dynamically selected at G1)
RAW_LAKEHOUSE_NAME=
SOURCE_TIMEZONE=Asia/Kolkata

# Note: No client secrets or client IDs are required!
# Authentication is performed interactively via Azure CLI (`az login`).
